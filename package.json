{
  "name": "btx-clinical-research",
  "version": "0.1.0",
  "description": "BTX Clinical Research website — an English-only Astro + Tailwind + Vercel single-page site.",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generate-git-dates.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "test:serve": "npm run build && npx http-server .vercel/output/static -p 9333 -s",
    "playwright:install": "playwright install chromium webkit",
    "audit:build": "node scripts/seo-plan/audit-build.mjs .vercel/output/static"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@upstash/redis": "^1.37.0",
    "astro": "^7.4.2",
    "resend": "^4.1.2",
    "tailwindcss": "^4.3.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^10.0.3",
    "http-server": "^14.1.1",
    "playwright": "^1.60.0",
    "vitest": "^4.1.8"
  }
}
